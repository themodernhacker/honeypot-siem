# --- Honeypot SIEM lab ---

# Captured honeypot logs (can contain attacker IPs / payloads; regenerate locally)
# Ignore the log contents but keep the folder via .gitkeep so the bind mount has a target.
cowrie/log/*
!cowrie/log/.gitkeep
cowrie-logs/
*.json.log

# Wazuh stack pulled in during setup (cloned, not committed)
wazuh-docker/

# Generated TLS certs / secrets
config/certs/
*.pem
*.key
*.crt
.env

# Python / tooling
__pycache__/
*.pyc

# Claude Code local files
.claude/

# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.idea/
.vscode/

# Keep the screenshots folder but ignore nothing inside (we DO commit screenshots)
!screenshots/
